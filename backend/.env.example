# Example backend env. Copy to .env (git-ignored) and fill in real values.
#
# SpectoStream live-overlay integration (consumed via application.properties:
# specto.base-url / specto.api-key / specto.enabled). Leave SPECTO_API_KEY blank
# to disable streaming entirely. Get a real key (sps_...) from the SpectoStream
# portal -> API keys.
SPECTO_BASE_URL=https://stream.safeflow.hr
SPECTO_API_KEY=futsaltest
SPECTO_ENABLED=true

# Stripe Checkout for paid recording-request downloads (consumed via
# application.properties: stripe.secret-key / stripe.webhook-secret). Leave
# blank to disable the payment flow entirely - StripeService.isConfigured()
# is false and POST /recording-requests/{uuid}/checkout replies NOT_CONFIGURED.
# Get the secret key from the Stripe dashboard -> Developers -> API keys, and
# the webhook signing secret from Developers -> Webhooks (after registering
# this app's /api/webhooks/stripe endpoint).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email over SMTP (consumed via application.properties:
# quarkus.mailer.*). Leave login/key blank to disable sending entirely -
# EmailService.isReady() is false and every send is a silent no-op.
# Resend: MAIL_SMTP_LOGIN is the literal string "resend", MAIL_SMTP_KEY is the
# API key (re_...) from resend.com -> API Keys, after the domain's SPF + DKIM
# DNS records are verified.
MAIL_SMTP_HOST=smtp.resend.com
MAIL_SMTP_PORT=587
MAIL_SMTP_LOGIN=
MAIL_SMTP_KEY=
MAIL_FROM=Futsal Turniri <obavijesti@futsal-turniri.com>

# Public base URL used to build links inside email bodies (status page,
# tournament pages). Local default is the Vite dev server.
APP_PUBLIC_BASE_URL=http://localhost:5181

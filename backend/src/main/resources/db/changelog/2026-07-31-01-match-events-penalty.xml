<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <!--
        In-game penalty marker on match events. A GOAL scored from a penalty
        awarded during regulation play carries penalty=true: it still counts
        as a regular goal everywhere (score recompute, scorer stats), but the
        timeline shows a "(pen.)" tag and the SpectoStream overlay receives a
        `penalty` event instead of a plain `goal`. Existing rows default to
        false. (The new PENALTY_MISSED_LIVE / EXCLUSION event types need no
        schema change - `type` is a varchar(20) enum-name column.)
    -->
    <changeSet id="2026-07-31-01-match-events-penalty" author="mrodek">
        <addColumn tableName="match_events">
            <column name="penalty" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>

<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <!--
        Per-user UI language preference ("hr"/"en"/"sl"), synced from the navbar
        language picker the same way color_mode already is - nullable, no
        default: null just means the account has no explicit pick yet and the
        frontend falls back to its own browser-detected/localStorage default.
    -->
    <changeSet id="2026-07-30-02-user-profiles-language" author="mrodek">
        <addColumn tableName="user_profiles">
            <column name="language" type="varchar(2)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>

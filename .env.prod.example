FIREBASE_PROJECT_ID=futsal-turniri

CORS_ORIGINS=https://futsal-turniri.com,https://www.futsal-turniri.com

APP_PUBLIC_BASE_URL=https://futsal-turniri.com

VITE_API_URL=/api

# ⚠ Copy these from the FUTSAL-TURNIRI Firebase project ONLY
# (Console → project "futsal-turniri" → Project settings → Your apps → Web app
#  → SDK setup and configuration). Do NOT paste another project's key - the
# apiKey is what tells the SDK which project to use, so a wrong key sends auth
# to the wrong project and Google logins fail with auth/unauthorized-domain.
VITE_FIREBASE_API_KEY=CHANGE_ME_FUTSAL_TURNIRI_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=futsal-turniri.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=futsal-turniri
VITE_FIREBASE_APP_ID=CHANGE_ME_FUTSAL_TURNIRI_APP_ID

VAPID_PUBLIC_KEY=BAStLdpxZ_TT9V1QtYiGnQWdFw3em8eoUXLJ6ZSx2Ponnwvv5V11B_h5SpVDvRjHBMxbkQ9dI1EBH4fAQ_z5X74
VAPID_PRIVATE_KEY=dBJ-fDfsZhySB8Cbh6k9eXI22OYXGPvIUPdFMz0lIxc
VAPID_SUBJECT=mailto:mihael.rodek1@gmail.com
# --- Email (Resend SMTP relay) ---
# Resend: MAIL_SMTP_LOGIN is the LITERAL string "resend", MAIL_SMTP_KEY is the
# API key (re_...) from resend.com -> API Keys. Port 587 + STARTTLS.
# The MAIL_FROM domain must be VERIFIED in Resend (Domains -> add
# futsal-turniri.com, then its SPF + DKIM records in DNS) - until it is,
# Resend refuses every send to anyone but your own account address, and
# EmailService only logs a WARN (sends are fire-and-forget, never surfaced).
# Leave login/key blank to disable mail entirely: isReady() is false and every
# send is a silent no-op.
MAIL_SMTP_HOST=smtp.resend.com
MAIL_SMTP_PORT=587
MAIL_SMTP_LOGIN=resend
MAIL_SMTP_KEY=
MAIL_FROM=Futsal Turniri <obavijesti@futsal-turniri.com>

# --- SpectoStream (live broadcast overlay) ---
# Same hosted platform for local dev AND prod - no localhost instance exists.
# Key from the SpectoStream portal (Postman flow 0.2 kreiraj API key).
SPECTO_BASE_URL=https://stream.safeflow.hr
SPECTO_API_KEY=futsaltest
SPECTO_ENABLED=true

# --- Stripe Checkout (paid recording downloads + /cjenik cart) ---
# LIVE-mode values on prod: sk_live_... from Developers -> API keys, and
# whsec_... from the endpoint you create at Developers -> Webhooks pointing
# at https://futsal-turniri.com/api/webhooks/stripe (event:
# checkout.session.completed). Leave BOTH blank to keep payments disabled -
# StripeService.isConfigured() is false and /checkout replies NOT_CONFIGURED.
# Never commit the real values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
